{
  "$description": "PIXELBOG design-tokens (W3C DTCG-format). Spejler styles/tokens.css.",
  "palette": {
    "$type": "color",
    "dmg-0": { "$value": "#0F380F", "$description": "Blæk (lys tilstand)" },
    "dmg-1": { "$value": "#306230", "$description": "Mørk grøn" },
    "dmg-2": { "$value": "#8BAC0F", "$description": "LCD-grøn" },
    "dmg-3": { "$value": "#C9D89A", "$description": "Papirgrøn" },
    "dmg-4": { "$value": "#E6EECB", "$description": "Papir lys" },
    "wine":  { "$value": "#7E2553", "$description": "Fare (lys)" },
    "crt-0": { "$value": "#0B0E1A", "$description": "Natsort" },
    "crt-1": { "$value": "#1D2B53", "$description": "RPG-blå" },
    "crt-2": { "$value": "#83769C", "$description": "Lavendel" },
    "crt-3": { "$value": "#C2C3C7", "$description": "Lysegrå" },
    "crt-4": { "$value": "#FFF1E8", "$description": "Fosfor-hvid" },
    "blue":   { "$value": "#29ADFF" },
    "green":  { "$value": "#00E436" },
    "yellow": { "$value": "#FFEC27" },
    "pink":   { "$value": "#FF77A8" },
    "red":    { "$value": "#FF004D" }
  },
  "theme": {
    "$type": "color",
    "light": {
      "ground":      { "$value": "{palette.dmg-2}" },
      "panel":       { "$value": "{palette.dmg-3}" },
      "panel-hi":    { "$value": "{palette.dmg-4}" },
      "frame":       { "$value": "{palette.dmg-0}" },
      "shadow":      { "$value": "{palette.dmg-1}" },
      "text":        { "$value": "{palette.dmg-0}", "$description": "8.6:1 på panel" },
      "text-soft":   { "$value": "{palette.dmg-1}", "$description": "4.7:1 på panel" },
      "line":        { "$value": "{palette.dmg-1}" },
      "select-bg":   { "$value": "{palette.dmg-2}" },
      "select-text": { "$value": "{palette.dmg-0}", "$description": "5.0:1" },
      "cursor":      { "$value": "{palette.dmg-0}" },
      "focus":       { "$value": "{palette.wine}" },
      "primary":     { "$value": "{palette.dmg-1}" },
      "on-primary":  { "$value": "{palette.dmg-4}", "$description": "6.0:1" },
      "secondary":   { "$value": "{palette.dmg-4}" },
      "on-secondary":{ "$value": "{palette.dmg-0}" },
      "danger":      { "$value": "{palette.wine}" },
      "on-danger":   { "$value": "{palette.dmg-4}", "$description": "7.7:1" },
      "danger-text": { "$value": "{palette.wine}", "$description": "6.0:1 på panel" },
      "ok":          { "$value": "{palette.dmg-0}" },
      "badge-bg":    { "$value": "{palette.wine}" },
      "badge-text":  { "$value": "{palette.dmg-4}" },
      "toast-bg":    { "$value": "{palette.dmg-0}" },
      "toast-text":  { "$value": "{palette.dmg-4}" },
      "hp":          { "$value": "{palette.dmg-1}" },
      "hp-empty":    { "$value": "{palette.dmg-4}" },
      "link":        { "$value": "{palette.dmg-0}" },
      "bezel":       { "$value": "{palette.dmg-1}", "$description": "Konsol-kabinet på mobil" },
      "bezel-text":  { "$value": "{palette.dmg-4}", "$description": "6.0:1" },
      "bezel-shadow":{ "$value": "{palette.dmg-0}" }
    },
    "dark": {
      "ground":      { "$value": "{palette.crt-0}" },
      "panel":       { "$value": "{palette.crt-1}" },
      "panel-hi":    { "$value": "{palette.crt-0}" },
      "frame":       { "$value": "{palette.crt-4}" },
      "shadow":      { "$value": "{palette.crt-2}" },
      "text":        { "$value": "{palette.crt-4}", "$description": "12.5:1 på panel" },
      "text-soft":   { "$value": "{palette.crt-3}", "$description": "7.8:1 på panel" },
      "line":        { "$value": "{palette.crt-2}", "$description": "3.3:1 — kun grafik" },
      "select-bg":   { "$value": "{palette.blue}" },
      "select-text": { "$value": "{palette.crt-0}", "$description": "7.8:1" },
      "cursor":      { "$value": "{palette.yellow}" },
      "focus":       { "$value": "{palette.yellow}" },
      "primary":     { "$value": "{palette.blue}" },
      "on-primary":  { "$value": "{palette.crt-0}" },
      "secondary":   { "$value": "{palette.crt-0}" },
      "on-secondary":{ "$value": "{palette.crt-4}" },
      "danger":      { "$value": "{palette.red}" },
      "on-danger":   { "$value": "{palette.crt-0}", "$description": "4.9:1" },
      "danger-text": { "$value": "{palette.pink}", "$description": "5.5:1 på panel" },
      "ok":          { "$value": "{palette.green}" },
      "badge-bg":    { "$value": "{palette.yellow}" },
      "badge-text":  { "$value": "{palette.crt-0}" },
      "toast-bg":    { "$value": "{palette.yellow}" },
      "toast-text":  { "$value": "{palette.crt-0}" },
      "hp":          { "$value": "{palette.green}" },
      "hp-empty":    { "$value": "{palette.crt-0}" },
      "link":        { "$value": "{palette.blue}" },
      "bezel":       { "$value": "{palette.crt-2}", "$description": "Konsol-kabinet på mobil" },
      "bezel-text":  { "$value": "{palette.crt-0}", "$description": "4.6:1" },
      "bezel-shadow":{ "$value": "{palette.crt-0}" }
    }
  },
  "avatarRamp": {
    "$description": "Paletter til kvantisering af fotos (lys→mørk luminans).",
    "light": { "$type": "color", "0": { "$value": "#0F380F" }, "1": { "$value": "#306230" }, "2": { "$value": "#8BAC0F" }, "3": { "$value": "#C9D89A" } },
    "dark":  { "$type": "color", "0": { "$value": "#0B0E1A" }, "1": { "$value": "#1D2B53" }, "2": { "$value": "#83769C" }, "3": { "$value": "#C2C3C7" }, "4": { "$value": "#FFF1E8" } }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Press Start 2P", "Silkscreen", "monospace"], "$description": "Logo og overskrifter. Kun 16/24/32 px." },
    "ui":      { "$value": ["Silkscreen", "Press Start 2P", "monospace"], "$description": "Knapper, labels, chips. 16 px." },
    "data":    { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Alle data: navne, numre, adresser." },
    "dialog":  { "$value": ["VT323", "IBM Plex Mono", "monospace"], "$description": "RPG-tekstbokse. 24 px." }
  },
  "fontSize": {
    "$type": "dimension",
    "display-xl": { "$value": "32px" },
    "display-l":  { "$value": "24px" },
    "display-m":  { "$value": "16px" },
    "ui":         { "$value": "16px" },
    "data-l":     { "$value": "20px" },
    "data":       { "$value": "16px" },
    "data-s":     { "$value": "14px" },
    "dialog":     { "$value": "24px" }
  },
  "lineHeight": { "$type": "number", "data": { "$value": 1.5 }, "ui": { "$value": 1.25 } },
  "space": {
    "$type": "dimension",
    "$description": "Pixel-grid: alt er multipla af 4 px.",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" },
    "12": { "$value": "48px" }, "16": { "$value": "64px" }
  },
  "border": {
    "$type": "dimension",
    "panel": { "$value": "4px" },
    "field": { "$value": "2px" }
  },
  "shadow": {
    "$type": "dimension",
    "offset": { "$value": "4px", "$description": "Hård skygge mod højre/ned, ingen blur." },
    "press":  { "$value": "2px", "$description": "Knap forskydes 2 px og skyggen forsvinder." }
  },
  "size": {
    "$type": "dimension",
    "avatar-s": { "$value": "40px" }, "avatar-m": { "$value": "64px" }, "avatar-l": { "$value": "160px" },
    "touch": { "$value": "44px" }, "icon-s": { "$value": "16px" }, "icon-m": { "$value": "24px" },
    "sidebar": { "$value": "264px" }, "list": { "$value": "384px" }
  },
  "motion": {
    "$type": "duration",
    "press": { "$value": "80ms" }, "fast": { "$value": "160ms" }, "base": { "$value": "240ms" },
    "exit": { "$value": "160ms" }, "blink": { "$value": "1000ms" }, "type-per-char": { "$value": "24ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": "0px" }, "tablet": { "$value": "768px" }, "desktop": { "$value": "1024px" }
  }
}
