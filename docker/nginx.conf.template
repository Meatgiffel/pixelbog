# PIXELBOG — nginx i containeren.
# ${RADICALE_URL}, ${LISTEN_PORT} og ${BASE_PATH} udfyldes fra miljøet ved opstart.

server {
    listen ${LISTEN_PORT};
    server_tokens off;
    root /usr/share/nginx/html;

    # Kontakter med fotos kan fylde lidt
    client_max_body_size 25m;

    # Radicale ligger bag /dav/, så browseren taler med samme origin (ingen CORS)
    location /dav/ {
        proxy_pass ${RADICALE_URL}/;
        # Fortæller Radicale, at den er monteret under /dav, så hrefs i svarene passer
        proxy_set_header X-Script-Name ${BASE_PATH}/dav;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Ellers viser browseren sin egen login-boks oven i appens
        proxy_hide_header WWW-Authenticate;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
